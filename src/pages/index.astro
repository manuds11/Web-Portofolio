---
import "../styles/global.css";

const milestones = [
  ["Harmonic oscillator", "Built", "complete"],
  ["3D motion", "Built", "complete"],
  ["Multibody systems", "Current", "current"],
  ["Control", "Next", "future"],
  ["Marine dynamics", "Planned", "future"],
  ["Dynamic Positioning", "Goal", "goal"],
];

const projects = [
  { number:"01", eyebrow:"Current work", title:"Multibody Systems", description:"A modular real-time physics framework for constrained mechanical systems, built in Unreal Engine with custom C++ solvers.", tags:["C++","Unreal Engine","Lagrange multipliers","Numerical integration"], kind:"multibody" },
  { number:"02", eyebrow:"Foundation", title:"Harmonic Oscillator", description:"A first controlled environment for studying integration, damping, energy and the behaviour of a physical model in real time.", tags:["Dynamics","Energy","Integration"], kind:"oscillator" },
  { number:"03", eyebrow:"Foundation", title:"3D Motion & Orientation", description:"Helical motion, camera systems and quaternion-based orientation as a bridge from one-dimensional models to spatial simulation.", tags:["3D kinematics","Quaternions","Cameras"], kind:"helical" },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content="Naval engineering, real-time physics simulation and control on a path toward Dynamic Positioning." />
    <title>Manuel Delgado — Engineering Simulation</title>
  </head>
  <body>
    <main>
      <header class="site-header">
        <a class="identity" href="#top" aria-label="Back to top"><span class="identity-mark">MD</span><span>Manuel Delgado</span></a>
        <nav aria-label="Primary navigation"><a href="#roadmap">Roadmap</a><a href="#projects">Projects</a><a href="#about">About</a><a class="nav-emphasis" href="#cv">CV</a><a href="https://github.com/manuds11" target="_blank" rel="noreferrer">GitHub ↗</a></nav>
      </header>

      <section class="hero" id="top">
        <div class="hero-shade"></div>
        <div class="hero-content">
          <p class="kicker"><span></span> Naval engineering · Simulation · Control</p>
          <h1>Engineering<br />dynamic systems.</h1>
          <p class="hero-copy">Building real-time physics simulations and numerical tools on a path toward Dynamic Positioning.</p>
          <a class="hero-link" href="#roadmap">Explore the development path <span>↓</span></a>
        </div>
        <div class="hero-meta" aria-hidden="true"><span>40.9701° N</span><span>5.6635° W</span><span>REAL-TIME SYSTEMS</span></div>
      </section>

      <section class="roadmap section-shell" id="roadmap">
        <div class="section-heading"><div><p class="section-index">01 / DEVELOPMENT PATH</p><h2>From first principles<br />to marine control.</h2></div><p>A growing simulation framework. Each milestone adds a capability required for the final Dynamic Positioning system.</p></div>
        <ol class="milestone-track">
          {milestones.map((item, index) => <li class={item[2]}><span class="milestone-number">0{index + 1}</span><span class="milestone-dot"></span><strong>{item[0]}</strong><small>{item[1]}</small></li>)}
        </ol>
      </section>

      <section class="projects section-shell" id="projects">
        <div class="projects-intro"><p class="section-index">02 / SELECTED WORK</p><h2>Systems built<br />to understand.</h2><p>Current work first, followed by the experiments that made it possible.</p></div>
        <div class="project-list">
          {projects.map(project => <article class="project-card">
            <div class="project-copy"><div class="project-label"><span>{project.number}</span>{project.eyebrow}</div><h3>{project.title}</h3><p>{project.description}</p><ul>{project.tags.map(tag => <li>{tag}</li>)}</ul><a href="#about">View project <span>↗</span></a></div>
            <div class={`technical-visual ${project.kind}`} aria-hidden="true"><div class="grid-lines"></div><span class="axis axis-x"></span><span class="axis axis-y"></span>
              {project.kind === "multibody" && <div class="pendulum"><span class="pivot"></span><span class="rod rod-one"></span><span class="mass mass-one"></span><span class="rod rod-two"></span><span class="mass mass-two"></span></div>}
              {project.kind === "oscillator" && <span class="wave"></span>}
              {project.kind === "helical" && <span class="helix"></span>}
              <span class="visual-label">REAL-TIME OUTPUT</span>
            </div>
          </article>)}
        </div>
      </section>

      <section class="about section-shell" id="about"><p class="section-index">03 / ABOUT</p><div class="about-grid"><h2>Naval engineer.<br />Simulation builder.<br /><em>Still learning.</em></h2><div><p>I develop physics systems to understand the complete chain from mathematical model to numerical implementation and real-time visualisation.</p><p>This portfolio documents that progression and the engineering decisions behind it.</p><div class="about-links" id="cv"><a href="#top">Download CV <span>↓</span></a><a href="https://github.com/manuds11" target="_blank" rel="noreferrer">GitHub <span>↗</span></a></div></div></div></section>
      <footer><span>MANUEL DELGADO</span><span>ENGINEERING · SIMULATION · CONTROL</span><a href="#top">Back to top ↑</a></footer>
    </main>
  </body>
</html>
