---
import "../styles/global.css";

const milestones = [
  { title: "Unreal Engine API Testing", status: "Built", state: "complete", href: "#unreal-testing" },
  { title: "Harmonic Oscillator", status: "Built", state: "complete", href: "#harmonic-oscillator" },
  { title: "Multibody Systems", status: "Built", state: "complete", href: "#multibody-systems" },
  { title: "Multibody Control", status: "Next", state: "next" },
  { title: "Potential Flow on a 3D Airfoil", status: "Planned", state: "future" },
  { title: "RAOs", status: "Planned", state: "future" },
  { title: "Vessel Dynamics", status: "Planned", state: "future" },
  { title: "Vessel Control", status: "Planned", state: "future" },
  { title: "State Observer", status: "Planned", state: "future" },
  { title: "Thrust Allocation", status: "Planned", state: "future" },
  { title: "Dynamic Positioning", status: "Goal", state: "goal" },
];

const projects = [
  { number: "01", id: "multibody-systems", title: "Multibody Systems", description: "A general 2D multibody framework that numerically integrates the motion of systems connected by spring-dampers and rigid rods under gravity.", tags: ["Force Modeling", "Constraint Modeling", "Constraint Solver"], slides: [
    { title: "Real-Time Multibody Simulation", note: "A triple-pendulum configuration with tension springs demonstrates the coupled motion of the system.", visual: "multibody" },
    { title: "Modular System Configuration", note: "Bodies, spring-dampers and rigid rods can be assembled into different mechanical configurations.", visual: "configurations" },
    { title: "Spring-Damper Forces", note: "Forces from multiple spring-damper elements are evaluated and assembled for each body.", visual: "forces" },
    { title: "Rigid-Rod Constraints", note: "Rigid connections are enforced through a constraint solver based on Lagrange multipliers.", visual: "constraints" },
    { title: "Rod Length Correction", note: "Position- and velocity-level corrections are applied to prevent rod-length drift caused by unavoidable numerical error.", visual: "rod-length-correction" },
  ]},
  { number: "02", id: "harmonic-oscillator", title: "Harmonic Oscillator", description: "The most basic differential equation problem in dynamics, with an analytical solution that can be used to compare numerical integration methods and validate their implementation.", tags: ["Numerical Integration", "Fixed Time Step", "Data Analysis"], slides: [
    { title: "Real-Time Numerical Integration", note: "The oscillator is numerically integrated and visualized in real time within Unreal Engine.", visual: "oscillator", image: "/Web-Portofolio/images/harmonic-real-time.webp", video: "/Web-Portofolio/media/harmonic-real-time.webm", alt: "Harmonic oscillator running in real time in Unreal Engine" },
    { title: "Fixed Time Step", note: "A fixed time step and an accumulator decouple numerical integration from the rendering frame rate.", visual: "fixed-step", image: "/Web-Portofolio/images/harmonic-fixed-step.webp", alt: "Fixed simulation time step and numerical integrator configuration" },
    { title: "Data Analysis", note: "State variables and forces are exported to Python to inspect the damped response of the system.", visual: "data-analysis", image: "/Web-Portofolio/images/harmonic-data-analysis.webp", alt: "Harmonic oscillator state and force analysis plots" },
    { title: "Explicit Euler", note: "With Explicit Euler, the energy balance—including dissipated energy—drifts above the initial system energy, revealing numerical energy injection.", visual: "explicit-euler", image: "/Web-Portofolio/images/harmonic-explicit-euler.webp", alt: "Energy balance showing positive energy drift with Explicit Euler integration" },
    { title: "Semi-Implicit Euler", note: "With Semi-Implicit Euler, the energy balance—including dissipated energy—remains close to the initial system energy.", visual: "semi-implicit-euler", image: "/Web-Portofolio/images/harmonic-semi-implicit-euler.webp", alt: "Energy balance remaining close to initial energy with Semi-Implicit Euler integration" },
  ]},
  { number: "03", id: "unreal-testing", title: "Unreal Engine API Testing", description: "Basic project to test cinematic visualization of meshes.", tags: ["3D Kinematics", "Quaternions", "Camera Systems"], slides: [
    { title: "3D Motion", note: "A parameterized 3D trajectory is used to explore Unreal Engine capabilities within a virtual environment.", visual: "helical", image: "/Web-Portofolio/images/debug-probe-3d-motion.webp", video: "/Web-Portofolio/media/debug-probe-3d-motion.webm", alt: "Unreal Engine simulation showing a parameterized three-dimensional trajectory" },
    { title: "Position & Orientation", note: "SetActorLocation and SetActorRotation are core Unreal Engine functions for controlling body motion. Quaternion-based rotations are supported directly by the Unreal Engine API.", visual: "orientation", image: "/Web-Portofolio/images/debug-probe-position-orientation.webp", alt: "Unreal Engine simulation showing a body, its orientation axes and a parameterized trajectory" },
    { title: "Runtime Controls", note: "Several runtime controls useful for simulation visualization are tested, including keyboard-controlled cameras and simulation start/stop.", visual: "camera", image: "/Web-Portofolio/images/debug-probe-runtime-controls.webp", alt: "Unreal Engine simulation with keyboard controls and runtime debugging information" },
    { title: "Real-Time Parameter Control", note: "Sliders are used to modify simulation parameters in real time, including vertical velocity, angular frequency and trajectory radius.", visual: "controls", image: "/Web-Portofolio/images/debug-probe-parameter-control.webp", alt: "Unreal Engine simulation with real-time frequency, radius and vertical velocity controls" },
  ]},
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content="Naval engineering, real-time physics simulation and control on a path toward Dynamic Positioning." />
    <title>Manuel Delgado Portfolio — Naval Engineering</title>
  </head>
  <body>
    <main>
      <header class="site-header">
        <a class="identity" href="#top" aria-label="Back to top"><strong>Manuel Delgado Portfolio</strong><span>— Naval Architect &amp; Marine Engineer</span></a>
        <nav aria-label="Primary navigation"><a href="#roadmap">Roadmap</a><a href="#projects">Projects</a><a href="#about">About</a><a class="nav-emphasis nav-orange" href="#cv">CV</a><a class="nav-orange" href="https://github.com/manuds11" target="_blank" rel="noreferrer">GitHub ↗</a></nav>
      </header>
      <section class="hero" id="top"><div class="hero-shade"></div><div class="hero-content"><h1>Unreal Engine<br />Dynamic Systems</h1><p class="hero-copy">Real-time physics simulations.</p><a class="hero-link" href="#roadmap">Explore the development path <span>↓</span></a></div></section>
      <section class="roadmap section-shell" id="roadmap">
        <div class="section-heading"><div><p class="section-index">DEVELOPMENT PATH</p><h2>Objective: Dynamic Positioning algorithm</h2></div></div>
        <ol class="milestone-track">{milestones.map((item, index) => <li class={item.state}>{item.href ? <a href={item.href}><span class="milestone-number">{String(index + 1).padStart(2, "0")}</span><span class="milestone-dot"></span><strong>{item.title}</strong><small>{item.status}</small></a> : <div><span class="milestone-number">{String(index + 1).padStart(2, "0")}</span><span class="milestone-dot"></span><strong>{item.title}</strong><small>{item.status}</small></div>}</li>)}</ol>
      </section>
      <div class="ocean-section" data-ocean-section>
      <section class="projects section-shell" id="projects">
        <div class="projects-intro"><p class="section-index">PROJECTS</p></div>
        <div class="project-list">{projects.map(project => <article class="project-card" id={project.id}>
          <div class="project-copy"><h3>{project.title}</h3><p>{project.description}</p><ul>{project.tags.map(tag => <li>{tag}</li>)}</ul><a href={`/Web-Portofolio/projects/${project.id}/`}>View full project <span>↗</span></a></div>
          <div class="project-media" data-carousel data-project={project.title}>
            <div class="carousel-viewport" data-track>{project.slides.map((slide) => <figure class="media-slide" data-slide><div class="technical-visual">{"video" in slide && slide.video && "image" in slide && slide.image ? <button class="media-preview video-preview" type="button" data-video-open data-video-src={slide.video} data-media-title={slide.title} aria-label={`Play ${slide.title} video`}><img src={slide.image} alt={slide.alt} loading="lazy" decoding="async" /><span class="play-button" aria-hidden="true">▶</span><span class="play-label">PLAY VIDEO</span></button> : "image" in slide && slide.image ? <button class="media-preview image-preview" type="button" data-image-open data-image-src={slide.image} data-media-title={slide.title} aria-label={`Enlarge ${slide.title} image`}><img src={slide.image} alt={slide.alt} loading="lazy" decoding="async" /><span class="enlarge-label">ENLARGE ↗</span></button> : <div class="provisional-visual" aria-hidden="true"><div class="grid-lines"></div><span class="visual-label">PROVISIONAL MEDIA</span></div>}</div><figcaption><strong>{slide.title}</strong><p>{slide.note}</p></figcaption></figure>)}</div>
            <div class="carousel-controls"><div class="slide-count" aria-live="polite"><span data-current>01</span> / {String(project.slides.length).padStart(2, "0")}</div><div><button type="button" data-prev aria-label={`Previous ${project.title} media`}>←</button><button type="button" data-next aria-label={`Next ${project.title} media`}>→</button></div></div>
          </div>
        </article>)}</div>
      </section>
      <section class="about section-shell" id="about" data-about><p class="section-index">ABOUT</p><div class="about-grid"><h2>Naval architecture<br /><span>Marine Engineering</span><strong>Unreal Engine Simulation</strong></h2><div><div class="about-links" id="cv"><a href="#top">Download CV <span>↓</span></a><a href="https://github.com/manuds11" target="_blank" rel="noreferrer">GitHub <span>↗</span></a></div></div></div></section>
      <footer><span>MANUEL DELGADO</span><span>PROJECT PORTFOLIO</span><a href="#top">Back to top ↑</a></footer>
      </div>
    </main>
    <div class="video-modal" data-video-modal hidden role="dialog" aria-modal="true" aria-labelledby="video-modal-title">
      <div class="video-dialog">
        <div class="video-modal-header"><span id="video-modal-title" data-video-modal-title>Simulation video</span><button type="button" data-video-close aria-label="Close video">×</button></div>
        <video data-video-player controls playsinline preload="metadata" hidden></video>
        <img data-image-viewer alt="" hidden />
      </div>
    </div>
    <script>
      document.querySelectorAll<HTMLElement>("[data-carousel]").forEach((carousel) => {
        const slides = Array.from(carousel.querySelectorAll<HTMLElement>("[data-slide]"));
        const track = carousel.querySelector<HTMLElement>("[data-track]");
        const counter = carousel.querySelector<HTMLElement>("[data-current]");
        let active = 0;
        const show = (next: number) => { active = (next + slides.length) % slides.length; track?.scrollTo({ left: slides[active]?.offsetLeft ?? 0, behavior: "smooth" }); if (counter) counter.textContent = String(active + 1).padStart(2, "0"); };
        carousel.querySelector("[data-prev]")?.addEventListener("click", () => show(active - 1));
        carousel.querySelector("[data-next]")?.addEventListener("click", () => show(active + 1));
        let touchStart = 0;
        carousel.addEventListener("touchstart", (event) => { touchStart = event.changedTouches[0]?.clientX ?? 0; }, { passive: true });
        carousel.addEventListener("touchend", (event) => { const distance = (event.changedTouches[0]?.clientX ?? 0) - touchStart; if (Math.abs(distance) > 45) show(active + (distance < 0 ? 1 : -1)); }, { passive: true });
        track?.addEventListener("scroll", () => { const width = track.clientWidth; if (!width) return; active = Math.max(0, Math.min(slides.length - 1, Math.round(track.scrollLeft / width))); if (counter) counter.textContent = String(active + 1).padStart(2, "0"); }, { passive: true });
      });

      const videoModal = document.querySelector<HTMLElement>("[data-video-modal]");
      const videoPlayer = videoModal?.querySelector<HTMLVideoElement>("[data-video-player]");
      const imageViewer = videoModal?.querySelector<HTMLImageElement>("[data-image-viewer]");
      const videoTitle = videoModal?.querySelector<HTMLElement>("[data-video-modal-title]");
      const closeButton = videoModal?.querySelector<HTMLButtonElement>("[data-video-close]");
      let videoTrigger: HTMLElement | null = null;
      const closeVideo = () => {
        if (!videoModal || videoModal.hidden) return;
        videoPlayer?.pause();
        videoPlayer?.removeAttribute("src");
        videoPlayer?.load();
        if (videoPlayer) videoPlayer.hidden = true;
        if (imageViewer) { imageViewer.hidden = true; imageViewer.removeAttribute("src"); }
        videoModal.hidden = true;
        document.body.classList.remove("modal-open");
        videoTrigger?.focus();
      };
      document.querySelectorAll<HTMLElement>("[data-video-open]").forEach((trigger) => trigger.addEventListener("click", () => {
        if (!videoModal || !videoPlayer) return;
        videoTrigger = trigger;
        videoPlayer.hidden = false;
        if (imageViewer) imageViewer.hidden = true;
        videoPlayer.src = trigger.dataset.videoSrc ?? "";
        if (videoTitle) videoTitle.textContent = trigger.dataset.mediaTitle ?? "Simulation video";
        videoModal.hidden = false;
        document.body.classList.add("modal-open");
        closeButton?.focus();
        videoPlayer.play().catch(() => undefined);
      }));
      document.querySelectorAll<HTMLElement>("[data-image-open]").forEach((trigger) => trigger.addEventListener("click", () => {
        if (!videoModal || !imageViewer) return;
        videoTrigger = trigger;
        videoPlayer?.pause();
        if (videoPlayer) videoPlayer.hidden = true;
        imageViewer.src = trigger.dataset.imageSrc ?? "";
        imageViewer.alt = trigger.getAttribute("aria-label") ?? "Enlarged simulation image";
        imageViewer.hidden = false;
        if (videoTitle) videoTitle.textContent = trigger.dataset.mediaTitle ?? "Simulation image";
        videoModal.hidden = false;
        document.body.classList.add("modal-open");
        closeButton?.focus();
      }));
      closeButton?.addEventListener("click", closeVideo);
      videoModal?.addEventListener("click", (event) => { if (event.target === videoModal) closeVideo(); });
      document.addEventListener("keydown", (event) => { if (event.key === "Escape") closeVideo(); });

      const oceanSection = document.querySelector<HTMLElement>("[data-ocean-section]");
      const aboutSection = document.querySelector<HTMLElement>("[data-about]");
      if (oceanSection && !window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
        let scheduled = false;
        const moveOcean = () => {
          const bounds = oceanSection.getBoundingClientRect();
          const distance = bounds.height + window.innerHeight;
          const progress = Math.max(0, Math.min(1, (window.innerHeight - bounds.top) / distance));
          oceanSection.style.setProperty("--ocean-shift", `${(progress - 0.5) * 90}px`);
          if (aboutSection) {
            const aboutTop = window.scrollY + aboutSection.getBoundingClientRect().top;
            const start = aboutTop - window.innerHeight * 0.72;
            const end = Math.max(start + 1, document.documentElement.scrollHeight - window.innerHeight);
            const reveal = Math.max(0, Math.min(1, (window.scrollY - start) / (end - start)));
            aboutSection.style.setProperty("--about-reveal", String(reveal));
          }
          scheduled = false;
        };
        window.addEventListener("scroll", () => { if (!scheduled) { scheduled = true; requestAnimationFrame(moveOcean); } }, { passive: true });
        moveOcean();
      }
    </script>
  </body>
</html>
